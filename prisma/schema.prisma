generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Supplier {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  supplierCode          String                  @unique @map("supplier_code") @db.VarChar(50)
  supplierName          String                  @map("supplier_name") @db.VarChar(200)
  supplierType          SupplierType            @default(MANUFACTURER) @map("supplier_type")
  contactPerson         String?                 @map("contact_person") @db.VarChar(200)
  mobile                String                  @db.VarChar(20)
  alternateMobile       String?                 @map("alternate_mobile") @db.VarChar(20)
  email                 String?                 @db.VarChar(320)
  gstin                 String?                 @db.VarChar(20)
  pan                   String?                 @db.VarChar(20)
  status                SupplierStatus          @default(ACTIVE)
  internalNotes         String?                 @map("internal_notes")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  products              products[]
  purchase_invoices     purchase_invoices[]
  addresses             SupplierAddress[]
  bankAccounts          SupplierBankAccount[]
  supplier_credit_notes supplier_credit_notes[]
  supplier_ledger       supplier_ledger[]
  supplier_payments     supplier_payments[]
  purchase_returns      purchase_returns[]

  @@index([supplierName])
  @@index([mobile])
  @@index([gstin])
  @@index([status])
  @@map("suppliers")
}

model SupplierAddress {
  id           String              @id @default(uuid(7)) @db.Uuid
  supplierId   String              @map("supplier_id") @db.Uuid
  addressType  SupplierAddressType @default(OFFICE) @map("address_type")
  addressLine1 String?             @map("address_line_1") @db.VarChar(300)
  addressLine2 String?             @map("address_line_2") @db.VarChar(300)
  city         String?             @db.VarChar(100)
  state        String?             @db.VarChar(100)
  pinCode      String?             @map("pin_code") @db.VarChar(10)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier     Supplier            @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_addresses")
}

model SupplierBankAccount {
  id                String   @id @default(uuid(7)) @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  bankName          String?  @map("bank_name") @db.VarChar(200)
  accountNumber     String?  @map("account_number") @db.VarChar(34)
  ifsc              String?  @db.VarChar(20)
  branch            String?  @db.VarChar(200)
  accountHolderName String?  @map("account_holder_name") @db.VarChar(200)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  supplier          Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@map("supplier_bank_accounts")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model customer_coupons {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String        @unique @db.VarChar(50)
  customer_id        String        @db.Uuid
  value              Decimal       @db.Decimal(14, 2)
  issue_date         DateTime      @db.Date
  expiry_date        DateTime      @db.Date
  status             coupon_status @default(Active)
  claimed_date       DateTime?     @db.Date
  claimed_invoice_id String?       @db.Uuid
  created_at         DateTime      @default(now()) @db.Timestamptz(6)
  updated_at         DateTime      @default(now()) @db.Timestamptz(6)
  customers          customers     @relation(fields: [customer_id], references: [id], map: "customer_coupons_customer_fk")

  @@index([customer_id], map: "customer_coupons_customer_idx")
  @@index([expiry_date], map: "customer_coupons_expiry_idx")
  @@index([claimed_invoice_id], map: "customer_coupons_invoice_idx")
  @@index([status])
}

