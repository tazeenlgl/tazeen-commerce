# Copy to .env (never commit .env). Placeholders only.
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Reserved for later tasks (not used yet). Required in production.
JWT_SECRET=
# PostgreSQL for tazeen_pos_db ONLY (app user tazeen_pos_app). Put the real password in .env, never here.
DATABASE_URL=postgresql://tazeen_pos_app:CHANGE_ME@localhost:5432/tazeen_pos_db?schema=public

# --- API security / abuse protection (in-memory, per-process; see README) ---
# Number of trusted reverse-proxy hops (0/false = use socket IP). Set to 1 behind one proxy.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=120
RATE_LIMIT_STRICT_WINDOW_SEC=60
RATE_LIMIT_STRICT_MAX=10
BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
MAX_CONCURRENT_REQUESTS=200
MAX_CONNECTIONS=1000
